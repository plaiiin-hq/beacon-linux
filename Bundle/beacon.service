# plaiiin Beacon: reports this machine's facts to a plaiiin Status inventory.
# The confinement below is systemd's, not ours: check it with `systemd-analyze security beacon.service`.
[Unit]
Description=plaiiin Beacon (inventory reporter)
Documentation=https://github.com/plaiiin-hq/App-Status/tree/main/Beacon/Linux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=beacon
Group=beacon
ExecStart=/usr/bin/beacon run --config /etc/beacon/beacon.json --state /var/lib/beacon
Restart=on-failure
RestartSec=30

# Its own state only; the consent file is root's and read-only to it.
StateDirectory=beacon
StateDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible

# It sees the parts of the system its fields read and nothing else: /etc is an empty read-only view with only what a
# network client and the os-release field need, and the places where other programs keep logs, mail, backups and keys
# are not there at all. (Optional paths carry a "-": a distribution without one is not an error.)
TemporaryFileSystem=/etc:ro
BindReadOnlyPaths=-/etc/os-release -/etc/beacon -/etc/resolv.conf -/etc/hosts -/etc/nsswitch.conf -/etc/host.conf -/etc/gai.conf -/etc/localtime -/etc/ssl -/etc/ca-certificates -/etc/pki
InaccessiblePaths=-/root -/boot -/srv -/opt -/mnt -/media -/var/log -/var/mail -/var/spool -/var/backups -/var/cache -/var/tmp -/var/lib/private -/var/lib/docker -/var/lib/containers -/run/user -/run/docker.sock -/run/containerd -/run/dbus -/run/systemd/private

# Bounded: whatever goes wrong inside it stays small. It needs a few MB of memory, a trickle of CPU, a handful of
# processes and files; its largest file is a report of at most 256 KB.
MemoryMax=64M
MemorySwapMax=0
OOMPolicy=stop
CPUQuota=25%
TasksMax=16
LimitNOFILE=64
LimitFSIZE=2M
LimitCORE=0
LogRateLimitIntervalSec=30
LogRateLimitBurst=100

# No privileges, ever.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# Nothing of the kernel to change.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes

# Out to the internet only, plus a netlink socket to read its interfaces' addresses (the "network" field; without
# CAP_NET_ADMIN it can only read): no local sockets, no raw sockets, no listening on anything it could be told to.
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
# It cannot start any program: everything is mounted non-executable except its own binary. (Not a seccomp
# rule on execve: systemd applies the filter before it starts the service, so that blocks the service itself;
# 0.1.0 died of it with SIGSYS, 0.1.1 with 203/EXEC.)
NoExecPaths=/
ExecPaths=/usr/bin/beacon
# Ordinary service calls only; a refused call fails with EPERM instead of killing the process. @resources stays
# allowed: Go raises its open-file limit with setrlimit at start.
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap
SystemCallFilter=~fork vfork

[Install]
WantedBy=multi-user.target
